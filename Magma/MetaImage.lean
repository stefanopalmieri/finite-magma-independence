/-- Total printer for the shared difftest token grammar. Mirrors
    `kamea-diff`'s `enc_prog` arm for arm. -/
def toTokens : Prog → String
  | .atom k     => s!"a{k.val}"
  | .var n      => s!"v{n}"
  | .lam b      => "l " ++ toTokens b
  | .app f x    => "@ " ++ toTokens f ++ " " ++ toTokens x
  | .callcc b   => "k " ++ toTokens b
  | .ref e      => "r " ++ toTokens e
  | .deref e    => "d " ++ toTokens e
  | .setref l e => "s " ++ toTokens l ++ " " ++ toTokens e
  | .cons a d   => "c " ++ toTokens a ++ " " ++ toTokens d
  | .car e      => "h " ++ toTokens e
  | .cdr e      => "t " ++ toTokens e
  | .pairp e    => "y " ++ toTokens e
  | .ite c t e  => "i " ++ toTokens c ++ " " ++ toTokens t ++ " " ++ toTokens e
  | .eqv a b    => "q " ++ toTokens a ++ " " ++ toTokens b

